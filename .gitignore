.playwright-cli/

# Build, package and local run artifacts
output/
*.zip
dist/
release/

# Desktop (Tauri 2) — keep plugin ZIP allowlist independent of these
desktop/node_modules/
desktop/dist/
desktop/src-tauri/target/
desktop/src-tauri/gen/
# 每个 crate 一个独立的 target/。用通配写法，加新 crate 时不会再漏一个进去
# ——reminders 就是这么被提交上去的（#84，194 MB）。
desktop/crates/*/target/
__pycache__/
.tmp-d04-ui/
.tmp-d04-cache/

# Logs and local env
*.log
.env
.env.*

# IDE files
.vscode/
.idea/

# 根目录的类型检查工具链（扩展本身仍然零构建、零依赖）
/node_modules/
tsc-files.txt
