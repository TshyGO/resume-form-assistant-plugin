{
  "$id": "https://resumepro.local/protocol/payloads/resume-update.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op"
  ],
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "setActiveTemplate",
        "saveProfile"
      ]
    },
    "templateId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "family",
        "custom"
      ],
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "family": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          },
          "maxItems": 200
        }
      }
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0
    }
  }
}
