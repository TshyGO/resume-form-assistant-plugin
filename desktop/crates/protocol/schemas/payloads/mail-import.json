{
  "$id": "https://resumepro.local/protocol/payloads/mail-import.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "uploadId",
    "kind",
    "byteSize",
    "sha256",
    "chunkIndex",
    "chunkCount",
    "chunkSha256",
    "bytesBase64"
  ],
  "properties": {
    "uploadId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "eml",
        "excerpt"
      ]
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "byteSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 26214400
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chunkIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 799
    },
    "chunkCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 800
    },
    "chunkSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytesBase64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 43692
    }
  }
}
