{
  "$id": "https://resumepro.local/protocol/responses/query-candidates.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["exact", "sameCompany"],
  "properties": {
    "exact": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationId", "company", "title"],
        "properties": {
          "applicationId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          "company": { "type": "string", "minLength": 1, "maxLength": 200 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "stage": { "type": "string", "maxLength": 32 },
          "sourceUrl": { "type": "string", "maxLength": 2000 },
          "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
        }
      }
    },
    "sameCompany": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["applicationId", "company", "title"],
        "properties": {
          "applicationId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          "company": { "type": "string", "minLength": 1, "maxLength": 200 },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "stage": { "type": "string", "maxLength": 32 },
          "sourceUrl": { "type": "string", "maxLength": 2000 },
          "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" }
        }
      }
    }
  }
}
